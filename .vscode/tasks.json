{
    // See https://go.microsoft.com/fwlink/?LinkId=733558
    // for the documentation about the tasks.json format
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Run App",
            "type": "shell",
            "icon": {
                "id": "play",
                "color": "terminal.ansiGreen"
            },
            "command": "poetry run jerry-bot-tts --socket-path build/tts.sock --write-path build/out --lang-code a",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            }
        }
    ]
}